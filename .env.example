# Alur Cerita - Plan 1
# Settings ini dibaca otomatis oleh backend (python-dotenv).
# File .env yang sama juga dipakai frontend? Tidak - frontend hanya butuh
# VITE_* untuk override URL API, dan itu opsional (default: proxy Vite).

# --- Gemini ---
# Wajib diisi. Ambil dari https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# --- Narasi ---
# Kecepatan baca untuk estimasi durasi voice-over (kata per menit)
DEFAULT_WPM=150

# --- Pipeline ---
# Berapa kali Gemini diminta revisi storyboard kalau durasi visual meleset
MAX_RETRY=2
# Simpan respons mentah Gemini ke backend/debug_log/ untuk debug (1=on, 0=off)
GEMINI_DEBUG=1
